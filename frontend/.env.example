# ==============================================================================
# Oluso Streaming Frontend Environment Variables
# ==============================================================================

# Backend API Endpoint:
# - In local development: Leave blank to auto-connect to http://<hostname>:8000
# - In Vercel (Production): Set to your Heroku backend URL (e.g. https://your-backend-app.herokuapp.com)
# Note: The frontend automatically converts https:// to wss:// for live WebSocket video streams.
VITE_API_URL=https://your-backend-app.herokuapp.com

# Default device to select on startup
VITE_DEFAULT_DEVICE_ID=camera-001

# App display title
VITE_APP_NAME=Streaming Hub
